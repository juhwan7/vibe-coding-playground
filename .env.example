# 이 파일을 .env 로 복사한 뒤 실제 값으로 바꾸세요.
# .env 는 Git에 커밋하지 않습니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 장중 화면용 거래대금/현재가 최신화: 10초
# 기존 POLL_MS 값과 분리해 Raspberry Pi의 오래된 .env가 60초여도 새 기본값을 적용합니다.
MARKET_PRIMARY_REFRESH_MS=10000
POLL_MS=60000

# 상대적으로 무거운 상세/테마 1분봉 수집은 기존 주기를 유지합니다.
SLOW_POLL_MS=180000
THEME_FLOW_REFRESH_MS=60000

# 테마는 항상 4개를 유지합니다.
# 신규 후보가 기존 약한 테마보다 8% 이상 강하거나 3회 연속 우위를 확인하면 교체합니다.
THEME_REPLACEMENT_MARGIN=0.08
THEME_REPLACEMENT_CONFIRMATIONS=3

# 공개 수동 새로고침 남용 방지. 서버에서 최소 10초 이상으로 제한됩니다.
MANUAL_REFRESH_COOLDOWN_MS=20000

# 다른 Origin에서 API를 직접 호출해야 할 때만 정확한 Origin을 넣으세요.
# 비워두면 Access-Control-Allow-Origin 헤더를 보내지 않으며 같은 Origin 화면은 정상 작동합니다.
MARKET_ALLOWED_ORIGIN=

# 검증된 KOSPI200 선물 데이터 공급원이 있을 때만 연결합니다.
# JSON 응답 필드: updatedAt/source/priceChangeRate/tradingStrength/tradingVolume/openInterest/foreignNetContracts/institutionNetContracts
# 연결하지 않으면 선물 값은 임의 생성하지 않고 '실데이터 미연결'로 표시합니다.
FUTURES_SNAPSHOT_URL=
FUTURES_SNAPSHOT_TOKEN=
FUTURES_REFRESH_MS=10000

# 장 종료 복기 스냅샷 저장 위치. 기본 15:20 PRE_CLOSE / 15:35 FINAL을 35거래일 보관합니다.
CLOSE_ARCHIVE_CACHE_PATH=/app/data/close-archive.json

# 선택 사항: 금융위원회/금융투자협회 종합통계 공공데이터 연결용
# 서비스키가 없으면 투자자예탁금/CMA/신용/미수 값은 '-'로 표시합니다.
DATA_GO_KR_SERVICE_KEY=

# Firebase Web SDK
# Firebase Console > Project settings > Your apps > Web app의 firebaseConfig 값을 넣으세요.
# VITE_ 접두사가 붙은 값은 브라우저 번들에 포함될 수 있으므로 서버용 비밀키/서비스 계정 키를 넣지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
